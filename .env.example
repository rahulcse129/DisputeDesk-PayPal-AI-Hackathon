# ---------------------------------------------------------------------------
# DisputeDesk configuration. Copy to .env.local and fill in what you need.
# With no values at all the app runs fully offline: seeded PayPal data and a
# rules-based agent. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- PayPal --------------------------------------------------------------
# true  = seeded mock disputes, no PayPal calls (default when no credentials are set)
# false = live PayPal sandbox using the credentials below
USE_MOCK_PAYPAL=true
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- AI provider ---------------------------------------------------------
# anthropic | gemini | offline. Leave empty to use the first provider that has a key
# (Anthropic, then Gemini). With no key at all the offline rules engine runs
# (same tools, same trace).
AI_PROVIDER=

# --- Gemini --------------------------------------------------------------
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used if the main model stays overloaded (503 "high demand") after retries. "none" disables it.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# --- Anthropic -----------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Server-side refusal fallback (beta). Set to false to disable.
ANTHROPIC_SERVER_FALLBACK=true

# --- Elastic (optional) ---------------------------------------------------
# Turns on hybrid keyword + semantic search for case history and the agent's memory.
# Use ELASTIC_URL (e.g. https://my-project.es.us-east-1.aws.elastic.cloud) or ELASTIC_CLOUD_ID.
ELASTIC_URL=
ELASTIC_CLOUD_ID=
ELASTIC_API_KEY=
ELASTIC_INDEX=disputedesk-cases
ELASTIC_SEMANTIC=true
# Optional: inference endpoint for semantic_text (cluster default if empty)
ELASTIC_INFERENCE_ID=

# --- Storage -------------------------------------------------------------
# SQLite file for cases. On Render, point this at a persistent disk, e.g. /var/data/disputedesk.db
DATABASE_PATH=./data/disputedesk.db
